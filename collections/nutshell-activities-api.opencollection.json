{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nutshell Activities API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Activities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.nutshell.com/rest/activities",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "String search"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "How many activities to return"
              },
              {
                "name": "filter[participant][]",
                "value": "",
                "type": "query",
                "description": "Which participant to get activities related to"
              },
              {
                "name": "filter[status][]",
                "value": "",
                "type": "query",
                "description": "Which activities to get based on status"
              },
              {
                "name": "filter[leadPriority][]",
                "value": "",
                "type": "query",
                "description": "Whether to only return activities related to hot leads"
              },
              {
                "name": "filter[activityType]",
                "value": "",
                "type": "query",
                "description": "Which types of activities to get"
              },
              {
                "name": "filter[flagged]",
                "value": "",
                "type": "query",
                "description": "Only return flagged activities"
              },
              {
                "name": "filter[isImportant]",
                "value": "",
                "type": "query",
                "description": "Only return activities marked as important"
              },
              {
                "name": "filter[dateMin]",
                "value": "",
                "type": "query",
                "description": "The earliest activity to return"
              },
              {
                "name": "filter[dateMax]",
                "value": "",
                "type": "query",
                "description": "The latest activity to return"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get activities"
        },
        {
          "info": {
            "name": "Create an activity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.nutshell.com/rest/activities",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create an activity"
        },
        {
          "info": {
            "name": "Get an activity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.nutshell.com/rest/activities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Activity ID of the format {integer}-activities"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get an activity"
        },
        {
          "info": {
            "name": "Update an activity",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.nutshell.com/rest/activities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Activity ID of the format {integer}-activities"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Update an activity"
        },
        {
          "info": {
            "name": "Get activity types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.nutshell.com/rest/activitytypes",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get activity types"
        }
      ]
    }
  ],
  "bundled": true
}