{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nutshell Stagesets (Pipelines) API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Stagesets (Pipelines)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of stages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.nutshell.com/rest/stages",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get a list of stages"
        },
        {
          "info": {
            "name": "Get a list of pipelines",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.nutshell.com/rest/stagesets",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Gets a list of pipelines that leads can be assigned to. Pipelines are also known as stagesets."
        },
        {
          "info": {
            "name": "Get a CSV export of lead movements through a pipeline",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.nutshell.com/rest/stagesets/:id/export",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Stageset ID"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get a CSV export of lead movements through a pipeline"
        }
      ]
    }
  ],
  "bundled": true
}